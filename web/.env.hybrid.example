# ==============================================================================
# MediMate AI — Hybrid Strategic Deployment Configuration Example
# Profile: HYBRID (Private On-Premises Core with Explicit Cloud Augmentation)
# ==============================================================================

# Core Profile Setting
MEDIMATE_DEPLOYMENT_MODE=hybrid
DEPLOYMENT_ENV=hybrid
NEXT_PUBLIC_DEPLOYMENT_ENV=hybrid
NODE_ENV=production

# Web Endpoints (TLS Enforced)
NEXT_PUBLIC_URL=https://medimate.internal.org
AUTH_TRUST_HOST=https://medimate.internal.org

# Authentication & Key Management (Local master keyring with KMS bridge)
AUTH_SECRET=REPLACE_WITH_SECURE_BASE64_32_BYTE_SECRET
ENCRYPTION_KEY=REPLACE_WITH_SECURE_BASE64_32_BYTE_KEY

# Private On-Premises PostgreSQL (Clinical PHI database stays private)
POSTGRES_DB=open-health
APP_DB_USER=medimate_app
APP_DB_PASSWORD=REPLACE_WITH_SECURE_APP_DB_PASSWORD
OWNER_DB_USER=medimate_owner
OWNER_DB_PASSWORD=REPLACE_WITH_SECURE_OWNER_DB_PASSWORD
DATABASE_URL=postgresql://medimate_app:REPLACE_WITH_SECURE_APP_DB_PASSWORD@localhost:5432/open-health
MIGRATION_DATABASE_URL=postgresql://medimate_owner:REPLACE_WITH_SECURE_OWNER_DB_PASSWORD@localhost:5432/open-health

# Private On-Premises Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=open-health:

# Private Encrypted Document Storage (Raw medical records stay strictly local)
MEDIMATE_STORAGE_DIR=/app/storage
# Ephemeral RAM scratch directory
MEDIMATE_SCRATCH_DIR=/app/scratch

# Local AI Inference (Default for sensitive clinical summaries & PHI)
LOCAL_OLLAMA_ENDPOINT=http://localhost:11434

# Approved Cloud AI Providers (Injected for consented / de-identified queries)
# NOTE: In Hybrid mode, cloud AI is only reachable when explicit user consent
# and organization privacy policy gates pass. Zero silent fallback is enforced.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY

# Logging
LOG_LEVEL=info
