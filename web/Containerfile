FROM node:24.22.2-alpine
LABEL authors="OpenHealth"

RUN apk add -U graphicsmagick

WORKDIR /app

COPY package.json prisma/ .

RUN npm install

COPY . .

RUN npm run build && \
    adduser --disabled-password ohuser && \
    mkdir -p /app/storage && \
    chown -R ohuser /app

USER ohuser
EXPOSE 3000
ENTRYPOINT ["sh", "-c", "if [ \"$DEPLOYMENT_ENV\" = \"local\" ]; then npx prisma db push && npm run db:init-rls && npx prisma db seed; elif [ \"$RUN_MIGRATIONS\" = \"true\" ]; then npm run db:migrate:deploy; fi && exec npm start"]
