# MediMate AI — Production Environment Variables Configuration Template
# All production secrets must be injected via external secret manager (Vault, AWS Secrets Manager, or Doppler)
# NEVER commit populated values to Git.

# --- Core Platform Operating Mode ---
# Options: LOCAL | HYBRID | CLOUD
MEDIMATE_DEPLOYMENT_MODE=LOCAL
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- Database & Multi-Tenant Credentials ---
# Runtime Application Role (Least-Privilege: NOSUPERUSER, NOBYPASSRLS, NOINHERIT)
DB_APP_USER=medimate_app
DB_APP_PASSWORD=CHANGE_ME_IN_VAULT_MIN_32_CHARS_LOWER_UPPER_DIGIT_SPECIAL

# Schema Owner Role (Dedicated to forward migrations only)
DB_OWNER_USER=medimate_owner
DB_OWNER_PASSWORD=CHANGE_ME_IN_VAULT_MIN_32_CHARS_MIGRATION_ROLE

# Cluster Administrator Role (Bootstrapping only)
DB_ADMIN_USER=medimate_admin
DB_ADMIN_PASSWORD=CHANGE_ME_IN_VAULT_MIN_32_CHARS_ADMIN_BOOTSTRAP

# Database Connection Strings (Internal network addresses in Docker)
DATABASE_URL=postgresql://medimate_app:CHANGE_ME@postgres-prod:5432/medimate_prod_db
MIGRATION_DATABASE_URL=postgresql://medimate_owner:CHANGE_ME@postgres-prod:5432/medimate_prod_db

# --- Distributed Cache & Replay Protection ---
REDIS_PASSWORD=CHANGE_ME_IN_VAULT_STRONG_REDIS_AUTH_SECRET
REDIS_URL=redis://:CHANGE_ME@redis-prod:6379/0

# --- Web Application Session & Authentication ---
# 256-bit cryptographically random key: `openssl rand -hex 32`
AUTH_SECRET=CHANGE_ME_MIN_64_HEX_CHARS_FOR_SECURE_AUTH_SESSIONS
AUTH_TRUST_HOST=true

# --- Microservice Inter-Service Authentication (HMAC-SHA256) ---
# Shared between Next.js Web and Python RAG service
INTERNAL_SERVICE_SECRET=CHANGE_ME_SHARED_32_CHAR_MIN_SECRET_FOR_HMAC_ASSERTION

# --- Document Cryptographic Keys ---
# Local Master Encryption Key (256-bit hex, 64 characters)
LOCAL_ENCRYPTION_KEY=CHANGE_ME_64_HEX_DIGITS_AES256_GCM_DOCUMENT_KEY

# Dedicated Disaster Recovery Backup Key (256-bit hex, 64 characters)
BACKUP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_DIGITS_AES256_GCM_BACKUP_KEY

# --- Scratch & Temporary Plaintext Protection ---
PROTECTED_SCRATCH_DIR=/tmp/scratch
SCRATCH_ENCRYPTION_KEY=CHANGE_ME_64_HEX_DIGITS_FOR_EPHEMERAL_SCRATCH

# --- Python RAG Microservice Configuration ---
RAG_SERVICE_URL=http://medimate-rag-prod:8000
EMBEDDING_PROVIDER=fastembed
VECTOR_STORE_BACKEND=postgres

# --- Wearable Vendor OAuth Client Credentials (MOCK-TESTED in Local Mode) ---
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# OURARING_CLIENT_ID=
# OURARING_CLIENT_SECRET=

# --- Cloud KMS & S3 Credentials (Required ONLY for CLOUD Profile) ---
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=
# AWS_S3_DOCUMENT_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
