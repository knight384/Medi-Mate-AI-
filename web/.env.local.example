# ==============================================================================
# MediMate AI — Local Self-Hosted Deployment Configuration Example
# Profile: LOCAL (Self-Hosted on User / Organization Private Infrastructure)
# ==============================================================================

# Core Profile Setting
MEDIMATE_DEPLOYMENT_MODE=local
DEPLOYMENT_ENV=local
NEXT_PUBLIC_DEPLOYMENT_ENV=local
NODE_ENV=production

# Local Web & Network Endpoints
NEXT_PUBLIC_URL=http://localhost:3000
AUTH_TRUST_HOST=http://localhost:3000

# Authentication & Local Encryption (Generate base64 32-byte keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=REPLACE_WITH_SECURE_BASE64_32_BYTE_SECRET
ENCRYPTION_KEY=REPLACE_WITH_SECURE_BASE64_32_BYTE_KEY

# Database Roles & Least-Privilege Separation (Local PostgreSQL)
POSTGRES_DB=open-health
APP_DB_USER=medimate_app
APP_DB_PASSWORD=REPLACE_WITH_SECURE_APP_DB_PASSWORD
OWNER_DB_USER=medimate_owner
OWNER_DB_PASSWORD=REPLACE_WITH_SECURE_OWNER_DB_PASSWORD

# Runtime database connection (least-privileged application user with RLS enforced)
DATABASE_URL=postgresql://medimate_app:REPLACE_WITH_SECURE_APP_DB_PASSWORD@localhost:5432/open-health
# Migration database connection (DDL schema owner, migration-time only)
MIGRATION_DATABASE_URL=postgresql://medimate_owner:REPLACE_WITH_SECURE_OWNER_DB_PASSWORD@localhost:5432/open-health

# Local Redis Cache & Distributed Invocations
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=open-health:

# Local Private Document Storage
MEDIMATE_STORAGE_DIR=./storage/documents
# Ephemeral RAM/tmpfs scratch directory (never persistent storage)
MEDIMATE_SCRATCH_DIR=/dev/shm/medimate-scratch

# Local AI Inference (Ollama / Local LLM)
# In local mode, cloud AI calls are disabled by default
LOCAL_OLLAMA_ENDPOINT=http://localhost:11434

# Logging
LOG_LEVEL=info
