# MediMate AI — Python RAG Microservice Configuration
# Copy to .env in production / staging deployment

# Service Bind
RAG_SERVICE_HOST=0.0.0.0
RAG_SERVICE_PORT=8001
ENVIRONMENT=local

# Internal Trust Boundary (Shared with Next.js web application)
# Must be at least 32 characters, cryptographically secure
INTERNAL_SERVICE_SECRET=change-me-to-a-secure-32-char-minimum-secret-in-production

# Ephemeral Processing & Scratch
SCRATCH_DIR=/app/scratch
MAX_UPLOAD_SIZE_BYTES=33554432  # 32MB

# Embedding Provider (local | deterministic | remote)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Vector Store (memory | pgvector)
VECTOR_STORE_BACKEND=memory
DATABASE_URL=postgresql://medimate_rag_user:password@localhost:5432/open-health

# RAG Retrieval Defaults
DEFAULT_TOP_K=4
SIMILARITY_THRESHOLD=0.25
MAX_CHUNKS_PER_DOCUMENT=500
CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=80
